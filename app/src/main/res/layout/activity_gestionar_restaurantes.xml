<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:padding="16dp"
android:background="@drawable/fondo_ajustado">

        <TextView
            android:text="Gestión de Carta"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:background="#B3FFFFFF"
            android:shadowColor="#FFFFFF"
            android:shadowDx="1.0"
            android:shadowDy="1.0"
            android:shadowRadius="2.0"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical">

            <TextView
                android:text="Selecciona Categoría:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:background="#B3FFFFFF"
                android:shadowColor="#FFFFFF"
                android:shadowDx="1.0"
                android:shadowDy="1.0"
                android:shadowRadius="2.0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/btnImportarCsv"
                android:text="IMPORTAR CSV"
                android:backgroundTint="#546E7A"
                android:textColor="#FFF"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_width="wrap_content"
                android:layout_height="40dp"/>

            <Button
                android:id="@+id/btnAnadirPlato"
                android:text="+ AÑADIR PLATO"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFF"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_width="wrap_content"
                android:layout_height="40dp"/>
        </LinearLayout>

        <Spinner
            android:id="@+id/spinnerCategorias"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/spinner_background"
            android:padding="8dp" />

        <TextView
            android:text="Selecciona Plato:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:background="#B3FFFFFF"
            android:shadowColor="#FFFFFF"
            android:shadowDx="1.0"
            android:shadowDy="1.0"
            android:shadowRadius="2.0"
            android:layout_marginTop="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Spinner
            android:id="@+id/spinnerPlatos"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/spinner_background"
            android:padding="8dp" />

        <TextView
            android:text="Asignar a:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:background="#B3FFFFFF"
            android:shadowColor="#FFFFFF"
            android:shadowDx="1.0"
            android:shadowDy="1.0"
            android:shadowRadius="2.0"
            android:layout_marginTop="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Spinner
            android:id="@+id/spinnerAmigosMesa"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/spinner_background"
            android:padding="8dp" />

        <ListView
            android:id="@+id/listViewPlatos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:background="#E0E0E0" />

        <Button
            android:id="@+id/btnAnadirAMesa"
            android:text="AÑADIR A LA MESA"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"/>

        <Button
            android:id="@+id/btnVolver"
            android:text="VOLVER A LA MESA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#546E7A"
            android:layout_marginTop="10dp"/>
    </LinearLayout>